rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function ownsCollection() {
      return resource.data.profileId == request.auth.uid
        || resource.data.profileId == ('users/' + request.auth.uid)
        || resource.data.profileId == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function profilePatchIsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.size() > 0
        && changed.hasOnly(['name', 'onboardingDone'])
        && (
          !changed.hasAny(['name'])
          || (
            request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 120
          )
        )
        && (
          !changed.hasAny(['onboardingDone'])
          || request.resource.data.onboardingDone is bool
        );
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow update: if isSelf(uid) && profilePatchIsSafe();

      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt is timestamp;
      }

      match /drive_downloads/{fileId} {
        allow read: if isSelf(uid);
      }
    }

    match /collections/{slug} {
      allow read: if signedIn() && (ownsCollection() || isAdmin());
    }

    match /assets/{assetId} {
      allow read: if isAdmin();
    }
  }
}
